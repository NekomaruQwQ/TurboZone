{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Config",
  "description": "The serialized top-level configuration for TurboZone.",
  "type": "object",
  "properties": {
    "rules": {
      "description": "Rules in source order.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/definitions/Rule"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Pattern": {
      "description": "An exact string or a conjunction of nonempty literal partial patterns.",
      "anyOf": [
        {
          "description": "Exact match against the entire string.",
          "type": "string"
        },
        {
          "description": "Several non-empty partial predicates which are ANDed.",
          "type": "object",
          "properties": {
            "contains": {
              "description": "Required substring, or an empty string when omitted.",
              "type": "string"
            },
            "ends_with": {
              "description": "Required suffix, or an empty string when omitted.",
              "type": "string"
            },
            "starts_with": {
              "description": "Required prefix, or an empty string when omitted.",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ProgramFilter": {
      "description": "Program filters using serialized patterns or compiled predicates.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Optional case-insensitive program-name matcher.",
          "anyOf": [
            {
              "$ref": "#/definitions/Pattern"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "description": "Optional case-insensitive normalized-path matcher.",
          "anyOf": [
            {
              "$ref": "#/definitions/Pattern"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ResizeLimits": {
      "description": "Selector defaults and inclusive bounds; omitted bounds are unrestricted.",
      "type": "object",
      "properties": {
        "default": {
          "description": "Primary `[width, height]` in positive physical pixels, independent of selector bounds.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1
          },
          "maxItems": 2,
          "minItems": 2
        },
        "max": {
          "description": "Maximum `[width, height]` offered by the selector, in positive physical pixels.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1
          },
          "maxItems": 2,
          "minItems": 2
        },
        "min": {
          "description": "Minimum `[width, height]` offered by the selector, in positive physical pixels.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false
    },
    "ResizeRule": {
      "description": "Complete serialized resize behavior.",
      "anyOf": [
        {
          "description": "Resizing disabled or selector enabled without any size filters.",
          "type": "boolean"
        },
        {
          "description": "Exact target size. The selector is disabled in this mode.",
          "type": "object",
          "properties": {
            "exact": {
              "description": "Positive client-area `[width, height]` in physical pixels, independent of selector limits.",
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32",
                "maximum": 2147483647,
                "minimum": 1
              },
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "exact"
          ]
        },
        {
          "description": "Selector properties, including optional default, minimum, and maximum sizes.",
          "allOf": [
            {
              "$ref": "#/definitions/ResizeLimits"
            }
          ]
        }
      ]
    },
    "Rule": {
      "description": "One serialized rule pairing window filters with the actions they enable.",
      "type": "object",
      "properties": {
        "description": {
          "description": "User-facing section name, falling back to the rule name when empty.",
          "type": "string"
        },
        "move": {
          "description": "Relocation controls, currently only the \"center\" button.",
          "type": "boolean"
        },
        "name": {
          "description": "Unique stable identifier of the rule.",
          "type": "string"
        },
        "priority": {
          "description": "Higher priorities take precedence; zero is the default.",
          "type": "integer",
          "format": "int64"
        },
        "program": {
          "description": "Program filters.",
          "allOf": [
            {
              "$ref": "#/definitions/ProgramFilter"
            }
          ]
        },
        "resize": {
          "description": "Resize controls, target, and selector limits.",
          "allOf": [
            {
              "$ref": "#/definitions/ResizeRule"
            }
          ]
        },
        "window": {
          "description": "Window filters.",
          "allOf": [
            {
              "$ref": "#/definitions/WindowFilter"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "WindowFilter": {
      "description": "Window filters using serialized patterns or compiled predicates.",
      "type": "object",
      "properties": {
        "max": {
          "description": "Inclusive maximum client-area `[width, height]` in positive physical pixels.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1
          },
          "maxItems": 2,
          "minItems": 2
        },
        "min": {
          "description": "Inclusive minimum client-area `[width, height]` in positive physical pixels.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1
          },
          "maxItems": 2,
          "minItems": 2
        },
        "title": {
          "description": "Optional case-sensitive window-title matcher.",
          "anyOf": [
            {
              "$ref": "#/definitions/Pattern"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
