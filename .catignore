# `turbozone-core`
/crates/turbozone-core/src/**/*
!/crates/turbozone-core/src/lib.rs
!/crates/turbozone-core/src/config.rs
!/crates/turbozone-core/src/window.rs
!/crates/turbozone-core/src/bin/
!/crates/turbozone-core/src/bin/generate_schema.rs

# `turbozone-ui`
/crates/turbozone-ui/src/

# `turbozone-windows`
/crates/turbozone-windows/src/native.rs
/crates/turbozone-windows/src/window.rs

# Tests are maintained exclusively by agents
tests/

# Documentation is maintained exclusively by agents
*.md

# Generated files are always ignored even if they are versioned.
LICENSE
*.lock
*.schema.json

# BEGIN agent
/crates/turbozone-windows/src/backend.rs
# END agent
